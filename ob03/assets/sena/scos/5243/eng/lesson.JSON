xt\\\", \\\"content\\\": \\\"the address\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" at 135 Main Street\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"floor\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" the 7th floor\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"office or suite\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" suite 715\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" extra information\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" come 20 minutes early\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " Street and Suite Numbers - Nouns Relating to a Place or Building", "type": "heading"}, {"content": "Street and suite or floor numbers are not said like regular numbers.", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" What they say\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" What they mean\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" 1 - 35 Main Street</br> suite 7 - 15</br> 10 - 27 Carlton</br> we're in 15- 50</br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"135 Main Street</br> suite 715</br> 1027 Carlton Street</br> we're in office 1550</br>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "suite ", "type": "name"}, {"content": " a group of rooms or offices", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Our suite is on the 7th floor.", "type": "example"}, {"content": "engenn3le06ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you talk about where to go for an interview.", "type": "text"}]}, {"type": "target_word", "contents": [{"c