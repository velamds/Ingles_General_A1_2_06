ample", "content": "Example:  I look forward to seeing you in the halls."}, {"type": "audio", "content": "engenn3le06ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "internship "}, {"type": "definition", "content": "an unpaid training position"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I am very excited to start my internship."}, {"type": "audio", "content": "engenn3le06ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to impress"}, {"type": "definition", "content": " to show you can do something well"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Six months, maybe more if I impress my boss."}, {"type": "audio", "content": "engenn3le06ob04aud05"}]}, {"type": "background_image", "content": "engenn3le06ob04re1img01.png"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "You are a new intern in a company. With a partner, write down 5 questions each that you would ask the clerk about your job. "}, {"type": "text", "content": "Use capital letters and question marks."}, {"type": "text", "content": "Ask your partner your questions. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write questions to inquire about a job description."}, {"type": "text", "content": "I ask questions on job information I need."}, {"type": "text", "content": "I answer questions with proper information about a job."}]}], "labs": [{"stimuli": [{"_data": [], "id": 0, "type": "welcome", "contents": [{}], "template_override": 1}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn3le06ob04re2aud01", "coverimg": "engenn3le06ob04re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn3le06ob04re2img02.jpg"}, {"text": "<span class=\"strong\">Clerk</span>: Peter, you need to complete these 